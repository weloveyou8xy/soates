{
  "appId": "com.infiniteinnovative.soates",
  "productName": "Soates",
  "copyright": "© 2026 House of Heroia",
  "electronVersion": "45.3.4",
  "directories": { "output": "out", "buildResources": "." },
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] },
      { "target": "tar.gz", "arch": ["x64"] }
    ],
    "icon": "icon.png",
    "category": "Audio",
    "synopsis": "A music player that gives every song a beautiful room.",
    "description": "Soates plays music from YouTube Music, audio only, with a 10-band equalizer, visualizers, playlists and a community. Developed by 8xy, a House of Heroia venture.",
    "maintainer": "8xy | House of Heroia <office@heroia.org>",
    "vendor": "House of Heroia",
    "executableName": "soates",
    "artifactName": "Soates-${version}-linux-${arch}.${ext}",
    "desktop": {
      "entry": {
        "Name": "Soates",
        "Comment": "A music player that gives every song a beautiful room",
        "Keywords": "music;player;youtube;audio;",
        "StartupWMClass": "Soates"
      }
    }
  },
  "appImage": { "artifactName": "Soates-${version}-x86_64.AppImage" },
  "deb": {
    "artifactName": "soates_${version}_amd64.deb",
    "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0", "libasound2t64 | libasound2"]
  },
  "publish": [{ "provider": "github", "owner": "weloveyou8xy", "repo": "soates" }]
}
